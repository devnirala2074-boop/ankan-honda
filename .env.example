# ============================================================================
# ANKAN HONDA — GOOGLE PLACES API (NEW) CONFIGURATION
# ============================================================================
# Official Google Place ID for Ankan Honda (Batauli, Surguja, Chhattisgarh):
GOOGLE_PLACE_ID=ChIJdYLqtemRiTkRUi6ZhdHVgh0

# RECOMMENDED (Server-Side Proxy — Key is NEVER exposed in frontend bundle):
# 1. Enable "Places API (New)" in Google Cloud Console.
# 2. Restrict the key to "Places API (New)" under API restrictions.
# 3. Copy this file to `.env` and paste your key below:
GOOGLE_PLACES_API_KEY=

# OPTIONAL (Static-Only Hosting Fallback):
# Only set VITE_GOOGLE_PLACES_API_KEY if deploying to a static host without
# `/api/google-reviews` serverless support. You MUST apply HTTP Referrer
# restrictions (e.g. https://ankanhonda.in/*) and restrict to Places API (New).
VITE_GOOGLE_PLACES_API_KEY=
